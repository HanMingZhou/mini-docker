[Unit]
Description=mydocker CRI server
Documentation=https://github.com/mini-docker/mini-docker
After=network.target

[Service]
Type=exec
ExecStart=/usr/local/bin/mydocker-cri serve \
    --socket=/var/run/mydocker-cri.sock \
    --streaming-addr=127.0.0.1:10350 \
    --cni-conf-dir=/etc/cni/net.d \
    --cni-bin-dir=/opt/cni/bin \
    --cgroup-driver=systemd
Restart=on-failure
RestartSec=2
LimitNOFILE=1048576
# Delegate=yes 让 daemon 可以在自己的 scope 下继续创建子 cgroup。
Delegate=yes
# KillMode=process 仅杀主进程（pause 有自己的 session，不会被牵连）
KillMode=process
# 生命周期比 shell session 长，pause 的父是 PID 1（systemd 本身），不是 login shell。
TasksMax=infinity
StandardOutput=append:/var/log/mydocker-cri.log
StandardError=append:/var/log/mydocker-cri.log

[Install]
WantedBy=multi-user.target
